# Firebase 콘솔 (https://console.firebase.google.com) 에서 프로젝트 생성 후
# [프로젝트 설정] -> [내 앱] (웹 </>) 에서 확인한 설정값을 아래에 붙여넣고
# 이 파일 이름을 ".env" 로 변경(또는 복사)하여 사용하세요!

VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="my-travel-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-travel-app"
VITE_FIREBASE_STORAGE_BUCKET="my-travel-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"
